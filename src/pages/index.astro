---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Michely Dantas | Cybersecurity & Dev">
	<main class="max-w-5xl mx-auto px-8 py-20">
		<h2 class="text-5xl font-extrabold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">
			Sistemas de Informação & Cybersecurity
		</h2>
		<p class="text-zinc-400 text-lg mb-8 max-w-2xl">
			Atualmente no 5º semestre de SI. 
			Não desenvolvo nada e nem sei o que colocar aqui.
		</p>
		<div class="flex gap-4">
			<span class="px-3 py-1 bg-zinc-800 rounded-full text-sm">Ubuntu User</span>
			<span class="px-3 py-1 bg-zinc-800 rounded-full text-sm">Learning</span>
			<span class="px-3 py-1 bg-zinc-800 rounded-full text-sm">Uninassau</span>
		</div>
	</main>
</Layout>