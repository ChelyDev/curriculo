---
const { title } = Astro.props;
---
<html lang="pt-br">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body class="bg-slate-950 text-white antialiased">
		<nav class="flex justify-between p-8 max-w-5xl mx-auto">
			<h1 class="font-bold text-xl">Michely Dantas</h1>
			<div class="space-x-6">
				<a href="/" class="hover:text-blue-400">Início</a>
				<a href="/sobre" class="hover:text-blue-400">Sobre</a>
			</div>
		</nav>
		<slot /> </body>
</html>